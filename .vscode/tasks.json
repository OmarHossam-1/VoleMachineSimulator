{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build VoleMachineGUI (Auto-detect MSVC / MinGW)",
      "type": "shell",
      "command": "${workspaceFolder}/run_gui.bat",
      "args": ["--build"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$msCompile"],
      "detail": "Auto-detects MSVC or MinGW, compiles VoleMachineGUI.exe, and places it in the workspace root."
    },
    {
      "label": "Build VoleMachineGUI (MSVC cl.exe)",
      "type": "shell",
      "command": "cl.exe",
      "args": [
        "/nologo",
        "/std:c++17",
        "/EHsc",
        "/O2",
        "/W3",
        "/D_UNICODE",
        "/DUNICODE",
        "/I${workspaceFolder}/VoleMachineSimulator",
        "/I${workspaceFolder}/VoleMachineSimulator/gui",
        "/I${workspaceFolder}/VoleMachineSimulator/gui/imgui",
        "${workspaceFolder}/VoleMachineSimulator/gui/GuiMain.cpp",
        "${workspaceFolder}/VoleMachineSimulator/gui/GuiUI.cpp",
        "${workspaceFolder}/VoleMachineSimulator/gui/imgui/imgui.cpp",
        "${workspaceFolder}/VoleMachineSimulator/gui/imgui/imgui_draw.cpp",
        "${workspaceFolder}/VoleMachineSimulator/gui/imgui/imgui_tables.cpp",
        "${workspaceFolder}/VoleMachineSimulator/gui/imgui/imgui_widgets.cpp",
        "${workspaceFolder}/VoleMachineSimulator/gui/imgui/backends/imgui_impl_win32.cpp",
        "${workspaceFolder}/VoleMachineSimulator/gui/imgui/backends/imgui_impl_dx11.cpp",
        "${workspaceFolder}/VoleMachineSimulator/ALU.cpp",
        "${workspaceFolder}/VoleMachineSimulator/ControlUnit.cpp",
        "${workspaceFolder}/VoleMachineSimulator/Instruction.cpp",
        "${workspaceFolder}/VoleMachineSimulator/MemoryFile.cpp",
        "${workspaceFolder}/VoleMachineSimulator/RegisterFile.cpp",
        "${workspaceFolder}/VoleMachineSimulator/Screen.cpp",
        "${workspaceFolder}/VoleMachineSimulator/VoleMachine.cpp",
        "/Fe:${workspaceFolder}/VoleMachineGUI.exe",
        "/link",
        "/SUBSYSTEM:WINDOWS",
        "d3d11.lib",
        "dxgi.lib",
        "d3dcompiler.lib",
        "comdlg32.lib",
        "dwmapi.lib"
      ],
      "group": "build",
      "problemMatcher": ["$msCompile"],
      "detail": "Compiles VoleMachineGUI directly using cl.exe (requires MSVC Developer Command Prompt/tools active)."
    },
    {
      "label": "Build VoleMachineGUI (MinGW g++)",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-O2",
        "-DUNICODE",
        "-D_UNICODE",
        "-I${workspaceFolder}/VoleMachineSimulator",
        "-I${workspaceFolder}/VoleMachineSimulator/gui",
        "-I${workspaceFolder}/VoleMachineSimulator/gui/imgui",
        "${workspaceFolder}/VoleMachineSimulator/gui/GuiMain.cpp",
        "${workspaceFolder}/VoleMachineSimulator/gui/GuiUI.cpp",
        "${workspaceFolder}/VoleMachineSimulator/gui/imgui/imgui.cpp",
        "${workspaceFolder}/VoleMachineSimulator/gui/imgui/imgui_draw.cpp",
        "${workspaceFolder}/VoleMachineSimulator/gui/imgui/imgui_tables.cpp",
        "${workspaceFolder}/VoleMachineSimulator/gui/imgui/imgui_widgets.cpp",
        "${workspaceFolder}/VoleMachineSimulator/gui/imgui/backends/imgui_impl_win32.cpp",
        "${workspaceFolder}/VoleMachineSimulator/gui/imgui/backends/imgui_impl_dx11.cpp",
        "${workspaceFolder}/VoleMachineSimulator/ALU.cpp",
        "${workspaceFolder}/VoleMachineSimulator/ControlUnit.cpp",
        "${workspaceFolder}/VoleMachineSimulator/Instruction.cpp",
        "${workspaceFolder}/VoleMachineSimulator/MemoryFile.cpp",
        "${workspaceFolder}/VoleMachineSimulator/RegisterFile.cpp",
        "${workspaceFolder}/VoleMachineSimulator/Screen.cpp",
        "${workspaceFolder}/VoleMachineSimulator/VoleMachine.cpp",
        "-o",
        "${workspaceFolder}/VoleMachineGUI.exe",
        "-mwindows",
        "-ld3d11",
        "-ldxgi",
        "-ld3dcompiler",
        "-lcomdlg32",
        "-ldwmapi"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"],
      "detail": "Compiles VoleMachineGUI using MinGW g++."
    },
    {
      "label": "Build VoleMachineGUI (MSBuild Release x64)",
      "type": "shell",
      "command": "msbuild.exe",
      "args": [
        "${workspaceFolder}/VoleMachineSimulator.sln",
        "/t:VoleMachineGUI",
        "/p:Configuration=Release",
        "/p:Platform=x64",
        "/nologo",
        "/v:m"
      ],
      "group": "build",
      "problemMatcher": ["$msCompile"],
      "detail": "Compiles VoleMachineGUI using MSBuild with the solution configuration."
    },
    {
      "label": "Rebuild VoleMachineGUI",
      "type": "shell",
      "command": "${workspaceFolder}/run_gui.bat",
      "args": ["--rebuild-only"],
      "group": "build",
      "problemMatcher": ["$msCompile"],
      "detail": "Cleans previous binaries and recompiles VoleMachineGUI.exe from scratch."
    }
  ]
}
